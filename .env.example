# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=hypertube
POSTGRES_PASSWORD=hypertube
POSTGRES_DB=hypertube
DATABASE_URL=postgresql+asyncpg://hypertube:hypertube@db:5432/hypertube

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=supersecretjwtkey_placeholder_change_me_later

# ── Frontend URL (used for OAuth redirects and password reset links) ──────────
FRONTEND_URL=http://localhost:8080
# Set to true when serving over HTTPS so the auth cookie is only sent over TLS.
COOKIE_SECURE=false

# ── 42 OAuth ──────────────────────────────────────────────────────────────────
# Register your app at https://profile.intra.42.fr/oauth/applications
FT_CLIENT_ID=your_42_client_id
FT_CLIENT_SECRET=your_42_client_secret
FT_REDIRECT_URI=http://localhost:8080/api/oauth/42/callback

# ── GitHub OAuth ──────────────────────────────────────────────────────────────
# Register your app at https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:8080/api/oauth/github/callback

# ── SMTP (password reset emails) ─────────────────────────────────────────────
# Leave SMTP_HOST empty to skip sending emails (token is printed to logs instead)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@hypertube.com

# ── Catalog Enrichment ──────────────────────────────────────────────────────
# Optional. If missing/invalid, app runs in degraded mode without OMDb enrichment.
OMDB_API_KEY=your_omdb_api_key
TMDB_API_KEY=your_tmdb_api_key
# Optional. English / preferred-language subtitles for films with an IMDb id.
# Free key: https://www.opensubtitles.com/consumers
OPENSUBTITLES_API_KEY=

# ── Sources ─────────────────────────────────────────────────────────────────
# Both search sources are royalty-free / legally distributable, per the subject.
# Archive.org (feature_films collection, public-domain items only) needs no credentials.
# PeerTube is queried through SepiaSearch, limited to trusted instances and to
# Creative Commons / public-domain licences.
PEERTUBE_SEARCH_URL=https://sepiasearch.org/api/v1/search/videos
# When browsing with no search term, only show content at least this long (s),
# so the catalogue reads like a film library instead of short clips.
PEERTUBE_BROWSE_MIN_DURATION=600
# Uploader-declared PeerTube licences are not trustworthy, so only these
# instances (which publish their own free content) are searched and played.
PEERTUBE_TRUSTED_HOSTS=video.blender.org,peertube.debian.social,framatube.org

# ── Streaming Storage / Retention ───────────────────────────────────────────
TORRENT_MEDIA_DIR=/data/media
TORRENT_SUBTITLES_DIR=/data/subtitles
MEDIA_RETENTION_DAYS=30
# archive.org film(s) played from their MKV original, converted on the fly,
# to demonstrate MKV support (comma-separated identifiers).
MKV_DEMO_ITEMS=InTheParktinted

# Internal service URL used by user-service to query torrent-service catalog API
TORRENT_SERVICE_URL=http://torrent-service:8001
